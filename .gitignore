# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 数据库文件（本地数据，不入库）
backend/data/
*.db
*.db-journal
*.db-wal
*.db-shm

# 数据库备份（backup.bat 生成，体积大且是本机数据）
backups/

# 运行期临时文件（start.bat 会往这里写端口号）
.tmp/

# 前端
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.local

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 日志
*.log

# 构建 / 测试的中间产物
.tmp/
*.tsbuildinfo

# 工具产生的本地工作数据（会话记录、项目记忆）。
# 这些是本机的开发过程记录，不属于项目源码。
.workbuddy/
